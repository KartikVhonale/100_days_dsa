# ==============================================================================
# 100-Day FAANG DSA Preparation Platform - Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# Leave empty ("") during local development to use the Vite dev proxy in vite.config.js (/api -> http://localhost:5001).
# For production or cross-origin setups, specify your backend server URL (e.g. http://localhost:5001 or https://api.example.com).
VITE_API_URL=

# Application Title
VITE_APP_TITLE=FAANG 100 - Striver A2Z Preparation

# Default Preparation Track ('beginner' | 'intermediate' | 'advanced' | 'elite')
VITE_DEFAULT_TRACK=intermediate
